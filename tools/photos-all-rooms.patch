diff --git a/test/photos-all-rooms.test.jsx b/test/photos-all-rooms.test.jsx
new file mode 100644
index 0000000..67147d0
--- /dev/null
+++ b/test/photos-all-rooms.test.jsx
@@ -0,0 +1,39 @@
+// Photos placed in the text work in every room's posts, not only Explorer's Bay, and never show as a web address on a card.
+import { describe, it, expect } from 'vitest'
+import { render } from '@testing-library/react'
+import { MemoryRouter } from 'react-router-dom'
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import ArticleBody from '../src/explorers/ArticleBody'
+import PostCard from '../src/components/PostCard'
+import { withoutPhotos } from '../src/explorers/travelRules'
+
+const read = (p) => readFileSync(join(process.cwd(), p), 'utf8')
+const TEXT = 'First part.\n\n[photo: https://example.com/a.jpg | A red door]\n\nSecond part.'
+
+describe('photos in the text, in any room', () => {
+  it('the post page uses the photo-aware body for every post, not just Explorer’s Bay', () => {
+    const src = read('src/pages/PostPage.jsx')
+    expect(src).toMatch(/<ArticleBody text=/)
+    expect(src).not.toMatch(/post\.channel === 'explorers-bay' \? <ArticleBody/)
+  })
+  it('both post forms offer the photo tool whatever the room', () => {
+    for (const f of ['src/pages/NewPost.jsx', 'src/pages/EditPost.jsx']) {
+      expect(read(f), f).toMatch(/<PhotoTool /)
+      expect(read(f), f).not.toMatch(/TRAVEL_ROOM && <PhotoTool/)
+      expect(read(f), f).toMatch(/if \(photoProblems\(content\)\.length > 0/)
+    }
+  })
+  it('puts the photo where it was written, with its description', () => {
+    const { container } = render(<ArticleBody text={TEXT} />)
+    const kids = [...container.querySelector('.xb-body').children]
+    expect(kids.map((k) => k.tagName)).toEqual(['P', 'FIGURE', 'P'])
+    expect(kids[1].querySelector('img')).toHaveAttribute('alt', 'A red door')
+  })
+  it('a card preview leaves the photo line out, so no address shows', () => {
+    expect(withoutPhotos(TEXT)).toBe('First part.\n\nSecond part.')
+    const { container } = render(<MemoryRouter><PostCard post={{ id: 'x', title: 'T', content: TEXT, created_at: '2026-10-20T10:00:00Z', tags: [] }} /></MemoryRouter>)
+    expect(container.textContent).toContain('First part.')
+    expect(container.textContent).not.toMatch(/\[photo:|example\.com/)
+  })
+})
