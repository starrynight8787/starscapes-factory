// SARAH JUNIOR'S CLUBHOUSE (the Den) IS FOR CHILDREN (Gill, 22 October 2026, SFW-264), so the ICO's Children's Code applies to it. One rule follows from that: a child is never asked for anything
// on its pages. So no email box is shown there (the footer's newsletter box is hidden on the Clubhouse), every email form and the sign-up page say that sign-ups are for grown-ups, and the Clubhouse
// itself says plainly what it does and does not do. The reasoning is written down in the Children's Code assessment attached to SFW-264.
export const CLUBHOUSE_ROOM = 'sarah-jrs-den'
export const CLUBHOUSE_PATH = `/${CLUBHOUSE_ROOM}`
export const onClubhouse = (pathname) => typeof pathname === 'string' && (pathname === CLUBHOUSE_PATH || pathname.startsWith(`${CLUBHOUSE_PATH}/`))

export const GROWN_UPS_NOTE = 'For grown-ups: you must be 18 or over to sign up. If you are younger, please ask a grown-up to do it for you.'
export const ACCOUNT_AGE_NOTE = 'Accounts are for people aged 18 or over. If you are younger, please ask a grown-up.'

// Said to the child, in plain words. Every line must stay true: test/children-code.test.jsx checks them against what the site does.
export const CLUBHOUSE_PROMISE = [
  "We don't ask you for your name or your email.",
  "We don't follow you around the internet.",
  'A video only starts when you press play.',
]
